# PostgreSQL used by docker-compose
POSTGRES_USER=forms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forms_db

# Keycloak service account used for SkyMail requests
KEYCLOAK_TOKEN_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Optional mail templates. Empty values disable the related notification.
FORMMAIL_FORM_COPY_TEMPLATE_ID=
FORMMAIL_STATUS_CHANGED_TEMPLATE_ID=
FORMMAIL_PENDING_REMINDER_TEMPLATE_ID=